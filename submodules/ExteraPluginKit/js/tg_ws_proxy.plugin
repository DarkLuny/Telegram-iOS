/*
 * TG WS Proxy — the reference app's transport, run by the client itself.
 *
 * The original (Flowseal/tg-ws-proxy; the iOS port is amurcanov's tree) starts a
 * Go MTProxy on 127.0.0.1 with a `dd` secret, and asks Telegram to use it with
 * `https://t.me/proxy?server=127.0.0.1&port=1443&secret=dd…`. Its tunnel dials
 * `kws<dc>.<CloudFlare zone>` over WSS, so a network that drops Telegram's
 * addresses still reaches Telegram Web.
 *
 * This plugin is that app minus the button, with the server living in the
 * client: `proxy.local_start(domain)` asks the host to run the local MTProxy
 * (a plugin has no sockets, so the listener must be Swift), and the host also
 * adds the proxy entry to Telegram's list and makes it active. From then on the
 * client's own traffic goes through the tunnel; the plugin's only jobs are
 * picking the zone, starting and stopping the server, and telling the truth
 * about what the host reports.
 *
 * Automatic, like the reference once its button is pressed:
 *   - enabling the plugin picks a working zone itself and starts the proxy;
 *   - loading the plugin while the switch is on starts it again (the last zone
 *     is remembered and reused without probing);
 *   - the status row comes from the host: entry active, client connections and
 *     live upstream channels, so "connected" is never just a guess;
 *   - switching off removes the entry and returns the client to a direct
 *     connection;
 *   - the only difference from the reference app is that there is no button.
 */

var __id__ = "tg_ws_proxy";
var __name__ = "TG WS Proxy";
var __description__ = "Локальный MTProxy 127.0.0.1 внутри клиента через CloudFlare. Подбирает CF-домен сам, запускается при включении плагина и добавляет прокси в список Telegram — без кнопки, VPN и отдельного приложения.";
var __author__ = "tg-ws-proxy (Flowseal), порт для ExteraPluginKit";
var __version__ = "3.0.0";
var __min_version__ = "13.1.1";

// `cfproxyEnc` from tg-ws-proxy.go. The core decodes each entry into the zone it
// dials; the app shows the decoded names, and the test here does the same.
var CFPROXY_ENCODED = [
    "virkgj.com",
    "vmmzovy.com",
    "mkuosckvso.com",
    "zaewayzmplad.com",
    "twdmbzcm.com",
];

// The document an older build of this plugin wrote for the engine's web route.
// It is removed on load and unload: left in place it would keep moving the
// engine's sessions while the local proxy is the transport in use.
var LEGACY_CONFIG_FILE = "tg_ws_proxy.json";

// The host the probes ask for. `kws2` is a real front — every zone answers it —
// and a plain GET is enough to prove DNS and TLS work, even when the answer
// is 404.
var PROBE_DATACENTER = 2;
var PROBE_TIMEOUT = 4;

// `LogManager` from the app: consecutive duplicates collapse into a count, the
// list is capped, and these markers are always kept. Used for the plugin's own
// journal over the same probes and starts.
var ESSENTIAL_MARKERS = [
    "прокси", "запись", "канал", "ошибка", "подключ", "запуск", "домен",
    "proxy", "started", "error",
];
var MAX_LOG_LINES = 100;

// --- the core's pure functions --------------------------------------------

// `decodeCfDomain`: every letter before `.com` moves back by the number of
// letters in that part, and `.com` becomes `.co.uk`. Disguise, not encryption.
function decodeCfDomain(value) {
    var text = String(value);
    if (text.length < 4 || text.slice(-4) !== ".com") {
        return text;
    }
    var stem = text.slice(0, text.length - 4);
    var letters = 0;
    for (var i = 0; i < stem.length; i += 1) {
        var code = stem.charCodeAt(i);
        if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
            letters += 1;
        }
    }
    var shift = letters % 26;
    var result = "";
    for (var j = 0; j < stem.length; j += 1) {
        var c = stem.charCodeAt(j);
        if (c >= 97 && c <= 122) {
            result += String.fromCharCode(((c - 97 - shift + 26) % 26) + 97);
        } else if (c >= 65 && c <= 90) {
            result += String.fromCharCode(((c - 65 - shift + 26) % 26) + 65);
        } else {
            result += stem.charAt(j);
        }
    }
    return result + ".co.uk";
}

// `normalizeCfDomain`: lower case, no trailing dot, and only a `.co.uk` name
// survives — that suffix is what the app's zones use.
function normalizeCfDomain(value) {
    var decoded = decodeCfDomain(String(value)).trim().toLowerCase();
    if (decoded.length > 0 && decoded.charAt(decoded.length - 1) === ".") {
        decoded = decoded.slice(0, decoded.length - 1);
    }
    if (!decoded || decoded.slice(-6) !== ".co.uk") {
        return "";
    }
    return decoded;
}

function defaultCfproxyDomains() {
    var domains = [];
    for (var i = 0; i < CFPROXY_ENCODED.length; i += 1) {
        var domain = normalizeCfDomain(CFPROXY_ENCODED[i]);
        if (domain) {
            domains.push(domain);
        }
    }
    return domains;
}

var CF_DOMAINS = defaultCfproxyDomains();

// The host's rule, mirrored so the plugin only asks for what the listener
// accepts: lower case, no trailing dot, two or more ASCII labels, not a bare
// address.
function normalizeHost(value) {
    var text = String(value === undefined || value === null ? "" : value).trim().toLowerCase();
    while (text.length > 0 && text.charAt(text.length - 1) === ".") {
        text = text.slice(0, text.length - 1);
    }
    if (!text || text.length > 253) {
        return "";
    }
    if (/[\s\/:@]/.test(text)) {
        return "";
    }
    var labels = text.split(".");
    if (labels.length < 2) {
        return "";
    }
    for (var i = 0; i < labels.length; i += 1) {
        if (!/^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$/.test(labels[i])) {
            return "";
        }
    }
    if (/^[0-9]+$/.test(labels[labels.length - 1])) {
        return "";
    }
    return text;
}

// --- plugin ---------------------------------------------------------------

class TgWsProxyPlugin extends BasePlugin {
    // --- lifecycle --------------------------------------------------------

    on_plugin_load() {
        this.resetLog();
        this._busy = false;
        // `set_setting` can deliver the change callback synchronously, and this
        // method mirrors stored values into the screen; without the guard that
        // would start a connection from inside the load.
        this._loading = true;
        // A legacy document would compete with the local proxy.
        this.removeLegacyConfig();
        this._loading = false;

        this.entry("плагин загружен", "info");
        if (!this.localProxySupported()) {
            this.entry("эта сборка клиента не умеет локальный прокси", "error");
            return;
        }
        if (!this.get_setting("enabled", true)) {
            this.entry("прокси выключен, клиент на обычном маршруте", "info");
            return;
        }
        // The reference app's button, minus the button: start now, reusing the
        // zone chosen last time when there is one.
        this.startFromSettings();
    }

    on_plugin_unload() {
        // The tunnel belongs to the plugin: disabling or removing it has to take
        // the proxy entry away, or the client would keep dialing a port with
        // nothing behind it.
        this.removeLegacyConfig();
        if (this.localProxySupported()) {
            proxy.local_stop(() => {});
        }
        this.entry("плагин выгружен, прокси остановлен", "info");
    }

    // --- the host's local proxy -------------------------------------------

    localProxySupported() {
        var status = proxy.local_status();
        return !!(status && status.ok === true);
    }

    // The transport the screen reports. `null` when the build has no local
    // proxy; the object otherwise is the host's own view, not a guess.
    transportStatus() {
        var status = proxy.local_status();
        if (!status || status.ok !== true) {
            return null;
        }
        return status;
    }

    // `unverified` only changes what the user is told: a zone that did not
    // answer the probe is still tried, because the probe can be filtered where
    // the WebSocket tunnel is not.
    startTransport(domain, unverified) {
        if (this._busy) {
            return;
        }
        this._busy = true;
        this.entry("запуск локального MTProxy: kws1…5." + domain, "info");
        proxy.local_start(domain, (response) => {
            this._busy = false;
            var status = response && response.status ? response.status : null;
            if (!response || response.ok !== true || !status || status.running !== true) {
                var reason = (response && response.error) || (status && status.error) || "клиент не запустил прокси";
                this.entry("не удалось запустить прокси: " + reason, "error");
                ui.bulletin.show_error("Не удалось запустить прокси: " + reason);
                this.set_setting("enabled", false, true);
                return;
            }
            this.set_setting("last_domain", status.domain, false);
            this.entry("прокси слушает " + status.host + ":" + status.port + " · " + status.domain, "info");
            if (status.active === true) {
                this.entry("запись " + status.host + ":" + status.port + " активна в списке прокси", "info");
            } else {
                this.entry("запись добавлена, но не стала активной", "error");
            }
            if (unverified) {
                ui.bulletin.show_info("Прокси включён: " + status.domain + ". Домен не ответил на проверку.");
            } else {
                ui.bulletin.show_success("Прокси включён: " + status.host + ":" + status.port + " · " + status.domain);
            }
            this.scheduleScreenRefresh();
        });
    }

    stopTransport(quiet) {
        proxy.local_stop((response) => {
            var ok = !!(response && response.ok === true);
            this.entry(ok ? "прокси остановлен, запись удалена" : "прокси остановлен с ошибкой", ok ? "info" : "error");
            if (!quiet) {
                ui.bulletin.show_info("Выключено. Клиент вернулся на обычный маршрут.");
            }
            this.scheduleScreenRefresh();
        });
    }

    // The client connects to the proxy a moment after the entry becomes active;
    // one delayed rebuild turns "трафика ещё нет" into the live counters.
    scheduleScreenRefresh() {
        this.run_on_queue(() => {
            this.set_setting("screen_reload", Date.now(), true);
        }, 3000);
    }

    // --- choosing the zone -------------------------------------------------

    // 0 is "Автоматически"; 1..CF_DOMAINS.length are the zones in order.
    rawDomainIndex() {
        var index = parseInt(this.get_setting("zone_index", 0), 10);
        return isFinite(index) ? index : 0;
    }

    domainIndex() {
        var index = this.rawDomainIndex();
        if (index < 0 || index > CF_DOMAINS.length) {
            return 0;
        }
        return index;
    }

    isAuto() {
        return this.domainIndex() === 0;
    }

    customDomain() {
        return normalizeHost(this.get_setting("custom_domain", ""));
    }

    hasCustomInput() {
        return String(this.get_setting("custom_domain", "")).trim() !== "";
    }

    // The zone the form asks for when it is not automatic; "" when it is.
    desiredDomain() {
        if (this.hasCustomInput()) {
            return this.customDomain();
        }
        var index = this.domainIndex();
        if (index > 0) {
            return CF_DOMAINS[index - 1] || "";
        }
        return "";
    }

    // --- probing ----------------------------------------------------------

    probeOne(domain, timeout, callback) {
        var host = "kws" + PROBE_DATACENTER + "." + domain;
        http.get("https://" + host + "/", { timeout: timeout }, (response) => {
            var status = response && typeof response.status === "number" ? response.status : 0;
            if (status > 0) {
                this.entry("CF " + host + " — ответ " + status, "info");
            } else {
                this.entry("CF " + host + " — нет ответа (" + ((response && response.error) || "таймаут") + ")", "error");
            }
            callback(status);
        });
    }

    // All at once, not one after another: the point of picking a zone is to
    // take the first one that answers, and five sequential four-second timeouts
    // would make a blocked network look like five dead zones in a row.
    probeDomains(domains, timeout, done) {
        var results = [];
        var remaining = domains.length;
        if (remaining === 0) {
            done(results);
            return;
        }
        var finish = () => {
            remaining -= 1;
            if (remaining === 0) {
                done(results);
            }
        };
        for (var i = 0; i < domains.length; i += 1) {
            this.probeInto(domains[i], i, results, timeout, finish);
        }
    }

    probeInto(domain, position, results, timeout, finish) {
        this.probeOne(domain, timeout, (status) => {
            results[position] = { domain: domain, status: status };
            finish();
        });
    }

    // Any answer below 500 means the front is there: DNS and TLS worked and the
    // CloudFlare edge routed the host. 5xx means the edge could not reach the
    // origin, which is exactly what a WebSocket through it would hit too.
    firstReachable(results) {
        for (var i = 0; i < results.length; i += 1) {
            if (results[i] && results[i].status > 0 && results[i].status < 500) {
                return results[i];
            }
        }
        return null;
    }

    // --- starting ---------------------------------------------------------

    // What load and the switch both go through: the remembered zone when there
    // is one, otherwise the automatic choice.
    startFromSettings() {
        var custom = String(this.get_setting("custom_domain", "")).trim();
        if (custom) {
            var domain = normalizeHost(custom);
            if (!domain) {
                this.entry("свой домен не похож на имя хоста", "error");
                ui.bulletin.show_error("Свой домен не похож на имя хоста");
                this.set_setting("enabled", false, true);
                return;
            }
            this.startTransport(domain, false);
            return;
        }
        var index = this.domainIndex();
        if (index > 0) {
            this.startTransport(CF_DOMAINS[index - 1], false);
            return;
        }
        var remembered = normalizeHost(this.get_setting("last_domain", ""));
        if (remembered) {
            // Same zone as last time: no probe, start at once.
            this.entry("использую прежний домен: " + remembered, "info");
            this.startTransport(remembered, false);
            return;
        }
        this.autoConnect();
    }

    autoConnect() {
        if (this._busy) {
            return;
        }
        this._busy = true;
        this.entry("автоподбор CF-домена: проверяю " + CF_DOMAINS.length, "info");
        this.probeDomains(CF_DOMAINS, PROBE_TIMEOUT, (results) => {
            this._busy = false;
            var pick = this.firstReachable(results);
            if (!pick) {
                // The listener has its own fallbacks — Telegram's own web front,
                // then the datacenter address — so a failed probe is not a
                // reason to leave the user without a transport.
                this.entry("ни один CF-домен не ответил, включаю с запасным маршрутом", "error");
                ui.bulletin.show_info("CF-домены не ответили — прокси попробует запасной маршрут.");
                this.startTransport(CF_DOMAINS[0], true);
                return;
            }
            this.entry("выбран " + pick.domain + " (ответ " + pick.status + ")", "info");
            this.startTransport(pick.domain, false);
        });
    }

    // --- the switch and the selector --------------------------------------

    onEnabledChanged(value) {
        if (this._loading) {
            return;
        }
        var enabled = value === undefined || value === null ? !!this.get_setting("enabled", true) : !!value;
        if (enabled) {
            this.entry("включение: запускаю прокси", "info");
            this.startFromSettings();
        } else {
            this.stopTransport(false);
        }
    }

    onDomainChanged(value) {
        if (this._loading) {
            return;
        }
        // Choosing a zone while the transport is off only stores the choice.
        // While it is on, the choice takes effect at once, as the reference app's
        // button would.
        if (!this.get_setting("enabled", true)) {
            return;
        }
        if (this.hasCustomInput() || this.domainIndex() > 0) {
            this.startFromSettings();
        } else {
            this.autoConnect();
        }
    }

    // --- actions ----------------------------------------------------------

    // Probes only, no change: the reference app's "check" button.
    checkDomains() {
        var domains = CF_DOMAINS;
        if (this.hasCustomInput()) {
            var custom = this.customDomain();
            if (!custom) {
                ui.bulletin.show_error("Свой домен не похож на имя хоста");
                return;
            }
            domains = [custom];
        }
        this.entry("проверка CF-доменов: " + domains.length, "info");
        this.probeDomains(domains, PROBE_TIMEOUT, (results) => {
            var answered = 0;
            for (var i = 0; i < results.length; i += 1) {
                if (results[i] && results[i].status > 0 && results[i].status < 500) {
                    answered += 1;
                }
            }
            this.entry("проверено: " + results.length + ", ответили: " + answered, "info");
            ui.bulletin.show_info("Ответили " + answered + " из " + results.length + " доменов");
        });
    }

    refreshStatus() {
        var status = this.transportStatus();
        if (!status) {
            this.entry("состояние недоступно", "error");
        } else {
            this.entry("состояние: " + this.configSummary(), "info");
        }
        this.set_setting("screen_reload", Date.now(), true);
    }

    copyDomainList() {
        android_utils.copy_to_clipboard(CF_DOMAINS.join("\n"));
        ui.bulletin.show_copied_to_clipboard();
    }

    copyReport() {
        var status = this.transportStatus();
        var errors = [];
        var entries = this.logEntries();
        for (var i = 0; i < entries.length; i += 1) {
            if (entries[i].level === "error") {
                errors.push(entries[i].message);
            }
        }
        var report = "TG WS Proxy (плагин " + __version__ + ")\n";
        if (status && status.running === true) {
            report += "Прокси: MTProxy " + status.host + ":" + status.port + " · kws1…5." + status.domain + "\n";
            report += "Запись в списке: " + (status.active === true ? "активна" : "не активна") + "\n";
            report += "Соединения: " + (status.connections || 0) + ", каналы: " + (status.upstreams || 0) + "\n";
            if (status.upstream_error) {
                report += "Ошибка канала: " + status.upstream_error + "\n";
            }
            if (status.link) {
                report += "Ссылка: " + status.link + "\n";
            }
        } else {
            report += "Прокси: выключен\n";
        }
        report += "Выбор: " + (this.isAuto() ? "автоматически" : (this.desiredDomain() || "—")) + "\n";
        report += "Домены: " + CF_DOMAINS.join(", ") + "\n";
        if (!errors.length) {
            report += "Ошибки: нет\n";
        } else {
            report += "Ошибки:\n- " + errors.slice(-5).join("\n- ") + "\n";
        }
        android_utils.copy_to_clipboard(report);
        ui.bulletin.show_copied_to_clipboard();
    }

    openUrl(url) {
        if (!android_utils.open_url(url)) {
            ui.bulletin.show_error("Не удалось открыть ссылку");
        }
    }

    // --- the status row ---------------------------------------------------

    configSummary() {
        var status = this.transportStatus();
        if (!status) {
            return "Эта сборка клиента не умеет локальный прокси";
        }
        if (status.running !== true) {
            if (this.get_setting("enabled", true)) {
                return "Включается… запускаю локальный MTProxy";
            }
            return "Выключено · клиент на обычном маршруте";
        }
        var text = "MTProxy " + status.host + ":" + status.port + " · kws1…5." + status.domain;
        if (status.active !== true) {
            text += " · запись в списке не активна";
        } else if ((status.connections || 0) > 0 && (status.upstreams || 0) > 0) {
            text += " · соединений: " + status.connections + ", каналов: " + status.upstreams;
        } else if ((status.connections || 0) > 0) {
            text += " · клиент подключился, канал не поднят";
        } else {
            text += " · запись активна, трафика ещё нет";
        }
        if (status.upstream_error) {
            text += " · канал: ошибка";
        }
        return text;
    }

    // --- journal (LogManager) ---------------------------------------------

    resetLog() {
        this._log = [];
    }

    logEntries() {
        if (!this._log) {
            this._log = [];
        }
        return this._log;
    }

    isEssential(message) {
        var text = message.toLowerCase();
        for (var i = 0; i < ESSENTIAL_MARKERS.length; i += 1) {
            if (text.indexOf(ESSENTIAL_MARKERS[i].toLowerCase()) >= 0) {
                return true;
            }
        }
        return false;
    }

    entry(message, level) {
        var cleaned = String(message === undefined || message === null ? "" : message)
            .replace(/[↑↓][\s\S]*/, "")
            .trim();
        if (!cleaned) {
            return;
        }
        level = level || "info";
        var entries = this.logEntries();
        var last = entries.length ? entries[entries.length - 1] : null;
        if (last && last.message === cleaned) {
            last.count += 1;
        } else {
            entries.push({ message: cleaned, level: level, count: 1, essential: this.isEssential(cleaned) });
            if (entries.length > MAX_LOG_LINES) {
                entries.shift();
            }
        }
        this.log(cleaned);
    }

    visibleLogs() {
        var entries = this.logEntries();
        var showInfo = !!this.get_setting("log_show_info", true);
        var showError = !!this.get_setting("log_show_error", false);
        var result = [];
        for (var i = 0; i < entries.length; i += 1) {
            var item = entries[i];
            if (item.essential || (showInfo && item.level === "info") || (showError && item.level !== "info")) {
                result.push(item);
            }
        }
        return result;
    }

    logsAsText() {
        var entries = this.visibleLogs();
        var lines = [];
        for (var i = 0; i < entries.length; i += 1) {
            lines.push(entries[i].message + " (x" + entries[i].count + ")");
        }
        return lines.join("\n");
    }

    copyLogs() {
        android_utils.copy_to_clipboard(this.logsAsText());
        ui.bulletin.show_copied_to_clipboard();
    }

    clearLogs() {
        this.resetLog();
        this.entry("журнал очищен", "info");
        this.set_setting("log_reload", Date.now(), true);
    }

    // --- legacy document --------------------------------------------------

    removeLegacyConfig() {
        var documents = file_utils.get_documents_dir();
        if (!documents) {
            return;
        }
        var path = documents + "/" + LEGACY_CONFIG_FILE;
        if (file_utils.file_exists(path)) {
            file_utils.delete_file(path);
        }
    }

    // --- settings screen --------------------------------------------------

    row(key, text, options) {
        options = options || {};
        return new Text({
            key: key,
            text: text,
            icon: options.icon,
            subtext: options.subtext,
            accent: options.accent,
            red: options.red,
            on_click: options.on_click,
            create_sub_fragment: options.create_sub_fragment,
        });
    }

    create_settings() {
        var items = [
            new Header({ text: "Транспорт CloudFlare" }),
            new Switch({
                key: "enabled",
                text: "Локальный MTProxy",
                default: true,
                subtext: "Включено — клиент сам выбирает CF-домен, запускает прокси и добавляет его в список",
                icon: "msg_folders",
                on_change: (value) => this.onEnabledChanged(value),
            }),
            new Selector({
                key: "zone_index",
                text: "CF-домен",
                default: 0,
                items: ["Автоматически"].concat(CF_DOMAINS),
                icon: "msg_list",
                on_change: (value) => this.onDomainChanged(value),
            }),
            new Input({
                key: "custom_domain",
                text: "Свой домен",
                default: "",
                subtext: "Важнее списка. Применяется кнопкой ниже, переключателем или повторным включением",
                icon: "msg_link",
            }),
            this.row("status", "Состояние", {
                subtext: this.configSummary(),
                icon: "msg_settings",
            }),
            this.row("connect", this.hasCustomInput() ? "Подключиться к своему домену" : (this.isAuto() ? "Подобрать заново" : "Подключиться к выбранному"), {
                subtext: "Проверит домены и запустит прокси сейчас",
                icon: "msg_retry",
                accent: true,
                on_click: () => {
                    this.set_setting("enabled", true, false);
                    if (this.hasCustomInput() || this.domainIndex() > 0) {
                        this.startFromSettings();
                    } else {
                        this.autoConnect();
                    }
                },
            }),
            this.row("refresh", "Обновить состояние", {
                subtext: "Перечитать счётчики соединений у клиента",
                icon: "msg_retry",
                on_click: () => this.refreshStatus(),
            }),
            new Header({ text: "Проверка" }),
            this.row("check", "Проверить CF-домены", {
                subtext: "Запрос к kws" + PROBE_DATACENTER + ".<домен> с этого устройства",
                icon: "msg_retry",
                on_click: () => this.checkDomains(),
            }),
            this.row("copy_domains", "Скопировать список доменов", {
                icon: "msg_share",
                on_click: () => this.copyDomainList(),
            }),
            new Header({ text: "Журнал" }),
            new Switch({
                key: "log_show_info",
                text: "INFO",
                default: true,
                on_change: () => this.set_setting("log_reload", Date.now(), true),
            }),
            new Switch({
                key: "log_show_error",
                text: "ERROR",
                default: false,
                on_change: () => this.set_setting("log_reload", Date.now(), true),
            }),
            new Switch({
                key: "log_show_null",
                text: "NULL",
                subtext: "Скрыть журнал целиком",
                default: false,
                on_change: () => this.set_setting("log_reload", Date.now(), true),
            }),
            this.row("logs_page", "Открыть журнал", {
                subtext: this.logEntries().length + " строк",
                icon: "msg_list",
                create_sub_fragment: () => this.logsPage(),
            }),
            this.row("logs_copy", "Скопировать журнал", {
                icon: "msg_share",
                on_click: () => this.copyLogs(),
            }),
            this.row("logs_clear", "Очистить журнал", {
                icon: "msg_delete",
                red: true,
                on_click: () => this.clearLogs(),
            }),
            new Header({ text: "О проекте" }),
            this.row("help", "Справка", {
                subtext: "Как это работает и чего не делает",
                icon: "msg_settings",
                create_sub_fragment: () => this.helpPage(),
            }),
            this.row("report", "Собрать отчёт", {
                subtext: "Скопирует настройки и ошибки в буфер",
                icon: "msg_share",
                on_click: () => this.copyReport(),
            }),
            new Divider({}),
        ];
        return items;
    }

    // --- journal page -----------------------------------------------------

    logsPage() {
        var items = [new Header({ text: "Журнал" })];
        if (this.get_setting("log_show_null", false)) {
            items.push(this.row("logs_off", "Отображение логов отключено"));
            return items;
        }
        var entries = this.visibleLogs();
        if (!entries.length) {
            items.push(this.row("logs_empty", "Журнал пуст", {
                subtext: "Включите INFO или ERROR выше",
            }));
            return items;
        }
        for (var i = 0; i < entries.length; i += 1) {
            items.push(new Text({
                key: "log_" + i,
                text: "×" + entries[i].count + "  " + entries[i].message,
            }));
        }
        return items;
    }

    // --- help page --------------------------------------------------------

    helpPage() {
        return [
            new Header({ text: "Что делает плагин" }),
            new Text({ key: "help_1", text: "Поднимает MTProxy внутри клиента", subtext: "Локальный MTProxy на 127.0.0.1 (порт 1443) с секретом dd и подключает его к kws1.<домен> … kws5.<домен> — те же зоны CloudFlare, что использует tg-ws-proxy." }),
            new Text({ key: "help_2", text: "Добавляет прокси в список Telegram", subtext: "Клиент сам добавляет запись 127.0.0.1:1443 в список прокси и делает её активной — так же, как это делает приложение-референс ссылкой t.me/proxy." }),
            new Text({ key: "help_3", text: "Всё внутри клиента", subtext: "Нет VPN, отдельного приложения и профиля расширения. Порт слушает только это устройство, снаружи он недоступен." }),
            new Header({ text: "Как это работает" }),
            new Text({ key: "help_4", text: "Домен выбирается сам", subtext: "При включении плагин одновременно опрашивает все зоны, берёт первую ответившую и запускает прокси. Ничего нажимать не нужно — это единственное отличие от приложения-референса, где была кнопка." }),
            new Text({ key: "help_5", text: "Подключается сразу", subtext: "Прокси стартует при включении плагина и при каждом запуске, пока переключатель включён; выбор домена запоминается. Строка «Состояние» показывает то, что клиент реально видит: запись активна и сколько соединений/каналов поднято." }),
            new Text({ key: "help_6", text: "Запасной маршрут", subtext: "Если зона не отвечает, прокси пробует kws*.web.telegram.org и адрес датацентра. Поэтому сбой проверки не выключает транспорт." }),
            new Text({ key: "help_7", text: "Выключение возвращает обычный маршрут", subtext: "Выключите переключатель или сам плагин — запись удаляется, и клиент возвращается на адреса Telegram." }),
            new Text({ key: "help_8", text: "Свой домен", subtext: "Впишите зону, у которой есть поддомены kws1…kws5 на Telegram Web через CloudFlare. Свой домен важнее списка." }),
            new Header({ text: "Границы" }),
            new Text({ key: "help_9", text: "Список может устареть", subtext: "Зоны взяты из tg-ws-proxy. Если ни одна не отвечает, прокси всё равно стартует с запасным маршрутом и честно пишет об этом в журнале." }),
            new Text({ key: "help_10", text: "Это замена веб-маршрута движка", subtext: "Раньше плагин переключал встроенный веб-транспорт клиента через файл настройки. Теперь он поднимает настоящий локальный MTProxy — как приложение-референс." }),
            new Header({ text: "Ссылки" }),
            this.row("help_src", "Оригинальный tg-ws-proxy", {
                subtext: "Flowseal",
                icon: "msg_link",
                on_click: () => this.openUrl("https://github.com/Flowseal/tg-ws-proxy"),
            }),
            this.row("help_fork", "iOS-порт", {
                subtext: "amurcanov",
                icon: "msg_link",
                on_click: () => this.openUrl("https://github.com/amurcanov/tg-ws-proxy-ios"),
            }),
            this.row("help_docs", "MTProto Proxy Reference", {
                subtext: "core.telegram.org",
                icon: "msg_link",
                on_click: () => this.openUrl("https://core.telegram.org/mtproto/mtproto-transports"),
            }),
        ];
    }
}

var Plugin = TgWsProxyPlugin;