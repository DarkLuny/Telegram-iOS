/*
 * TG WS Proxy — CloudFlare-fronted Telegram Web transport, inside the client.
 *
 * The original (Flowseal/tg-ws-proxy; the iOS port is amurcanov's tree) runs a
 * local MTProto proxy on 127.0.0.1 and dials `kws<dc>.<CloudFlare zone>` over
 * WSS, so a network that drops Telegram's addresses still reaches Telegram Web.
 * A plugin cannot open a listening socket, and a proxy entry pointing at a port
 * with nothing behind it would break the account — but it does not need to:
 * this client already carries MTProto over Telegram Web's WebSocket (the route
 * it takes when direct TCP is blocked), and the only part it lacked was a way
 * to be told which host to dial. The build this plugin ships with reads that
 * from `Documents/tg_ws_proxy.json` and hands it to
 * `mt_session_set_web_endpoint` — the same call the engine's own web-transport
 * tests make. So the tunnel runs in the app process, through the app's own
 * network stack: no local port, no VPN, no separate app.
 *
 * It is automatic, like the reference app is once its button is pressed:
 *   - enabling the plugin picks a working zone itself and writes the document;
 *   - the client watches that document and moves its live sessions at once,
 *     so there is no restart and no Apply;
 *   - switching the plugin off puts the client back on Telegram's own hosts;
 *   - the client writes back what it applied, and the status row shows it.
 *
 * The only thing the reference app has that this plugin does not is the
 * button: everything here happens from the switch itself.
 */

var __id__ = "tg_ws_proxy";
var __name__ = "TG WS Proxy";
var __description__ = "MTProto через WebSocket CloudFlare внутри клиента. Подбирает рабочий CF-домен сам и подключается сразу при включении — без кнопки, перезапуска, VPN и локального порта.";
var __author__ = "tg-ws-proxy (Flowseal), порт для ExteraPluginKit";
var __version__ = "2.1.0";
var __min_version__ = "13.1.1";

// `cfproxyEnc` from tg-ws-proxy.go. The core decodes each entry into the zone it
// dials; the app shows the decoded names, and the test here does the same.
var CFPROXY_ENCODED = [
    "virkgj.com",
    "vmmzovy.com",
    "mkuosckvso.com",
    "zaewayzmplad.com",
    "twdmbzcm.com",
];

// The document the client build reads. Keep in step with `TgWsProxyConfig.fileName`
// in MTProtoRustEngine.
var CONFIG_FILE = "tg_ws_proxy.json";

// What the client wrote back after handing the endpoint to the engine. Keep in
// step with `TgWsProxyConfig.statusFileName`.
var STATUS_FILE = "tg_ws_proxy_status.json";

// The host the probes ask for. `kws2` is a real front — every zone answers it —
// and a plain GET is enough to prove DNS and TLS work, even when the answer
// is 404.
var PROBE_DATACENTER = 2;
var PROBE_TIMEOUT = 4;

// `LogManager` from the app: consecutive duplicates collapse into a count, the
// list is capped, and these markers are always kept. Used for the plugin's own
// journal over the same probes and saves.
var ESSENTIAL_MARKERS = [
    "pool", "key:", "started", "address:", "error", "failed", "blocked",
    "Пул", "Ключ:", "запущен", "Адрес:", "ошибка", "провалены", "заблокирован",
];
var MAX_LOG_LINES = 100;

// --- the core's pure functions --------------------------------------------

// `decodeCfDomain`: every letter before `.com` moves back by the number of
// letters in that part, and `.com` becomes `.co.uk`. Disguise, not encryption.
function decodeCfDomain(value) {
    var text = String(value);
    if (text.length < 4 || text.slice(-4) !== ".com") {
        return text;
    }
    var stem = text.slice(0, text.length - 4);
    var letters = 0;
    for (var i = 0; i < stem.length; i += 1) {
        var code = stem.charCodeAt(i);
        if ((code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
            letters += 1;
        }
    }
    var shift = letters % 26;
    var result = "";
    for (var j = 0; j < stem.length; j += 1) {
        var c = stem.charCodeAt(j);
        if (c >= 97 && c <= 122) {
            result += String.fromCharCode(((c - 97 - shift + 26) % 26) + 97);
        } else if (c >= 65 && c <= 90) {
            result += String.fromCharCode(((c - 65 - shift + 26) % 26) + 65);
        } else {
            result += stem.charAt(j);
        }
    }
    return result + ".co.uk";
}

// `normalizeCfDomain`: lower case, no trailing dot, and only a `.co.uk` name
// survives — that suffix is what the app's zones use.
function normalizeCfDomain(value) {
    var decoded = decodeCfDomain(String(value)).trim().toLowerCase();
    if (decoded.length > 0 && decoded.charAt(decoded.length - 1) === ".") {
        decoded = decoded.slice(0, decoded.length - 1);
    }
    if (!decoded || decoded.slice(-6) !== ".co.uk") {
        return "";
    }
    return decoded;
}

function defaultCfproxyDomains() {
    var domains = [];
    for (var i = 0; i < CFPROXY_ENCODED.length; i += 1) {
        var domain = normalizeCfDomain(CFPROXY_ENCODED[i]);
        if (domain) {
            domains.push(domain);
        }
    }
    return domains;
}

var CF_DOMAINS = defaultCfproxyDomains();

// The engine's rule, mirrored so the plugin writes only what the build accepts:
// lower case, no trailing dot, two or more ASCII labels, not a bare address.
function normalizeHost(value) {
    var text = String(value === undefined || value === null ? "" : value).trim().toLowerCase();
    while (text.length > 0 && text.charAt(text.length - 1) === ".") {
        text = text.slice(0, text.length - 1);
    }
    if (!text || text.length > 253) {
        return "";
    }
    if (/[\s\/:@]/.test(text)) {
        return "";
    }
    var labels = text.split(".");
    if (labels.length < 2) {
        return "";
    }
    for (var i = 0; i < labels.length; i += 1) {
        if (!/^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$/.test(labels[i])) {
            return "";
        }
    }
    if (/^[0-9]+$/.test(labels[labels.length - 1])) {
        return "";
    }
    return text;
}

// The status document's clock, as local HH:MM.
function formatAppliedTime(seconds) {
    var date = new Date(seconds * 1000);
    var hours = date.getHours();
    var minutes = date.getMinutes();
    return (hours < 10 ? "0" : "") + hours + ":" + (minutes < 10 ? "0" : "") + minutes;
}

// --- plugin ---------------------------------------------------------------

class TgWsProxyPlugin extends BasePlugin {
    // --- lifecycle --------------------------------------------------------

    on_plugin_load() {
        this.resetLog();
        this._busy = false;
        // `set_setting` can deliver the change callback synchronously, and this
        // method mirrors stored values into the screen; without the guard that
        // would start a connection from inside the load.
        this._loading = true;

        var config = this.readConfig();
        if (config && config.enabled) {
            this.set_setting("enabled", true, false);
            var index = CF_DOMAINS.indexOf(config.domain);
            if (index >= 0) {
                this.set_setting("domain_index", index + 1, false);
                this.set_setting("custom_domain", "", false);
            } else {
                this.set_setting("custom_domain", config.domain, false);
            }
        }

        var enabled = !!this.get_setting("enabled", true);
        this._loading = false;
        this.entry("плагин загружен", "info");

        if (!enabled) {
            this.entry("транспорт выключен, клиент использует обычный маршрут", "info");
            return;
        }
        if (config && config.enabled) {
            this.entry("маршрут уже действует: kws1…5." + config.domain, "info");
            return;
        }
        // No document, but the plugin is on: reconnect by itself, exactly as
        // enabling the plugin does in the reference app minus the button.
        var remembered = normalizeHost(this.get_setting("last_domain", ""));
        if (remembered) {
            this.entry("восстанавливаю прежний домен: " + remembered, "info");
            this.applyDomain(remembered, false);
            return;
        }
        this.connect();
    }

    on_plugin_unload() {
        // The tunnel is the plugin: disabling it (or removing it) must put the
        // client back on Telegram's own hosts. The last domain is kept in the
        // settings, so the next load reconnects without probing again.
        this.removeConfig(true);
        this.entry("плагин выгружен, транспорт снят", "info");
    }

    // --- the document the client build reads ------------------------------

    configPath() {
        var documents = file_utils.get_documents_dir();
        if (!documents) {
            return "";
        }
        return documents + "/" + CONFIG_FILE;
    }

    statusPath() {
        var documents = file_utils.get_documents_dir();
        if (!documents) {
            return "";
        }
        return documents + "/" + STATUS_FILE;
    }

    readConfig() {
        var path = this.configPath();
        if (!path) {
            return null;
        }
        var text = file_utils.read_file(path);
        if (!text) {
            return null;
        }
        var parsed = null;
        try {
            parsed = JSON.parse(text);
        } catch (error) {
            this.entry("файл настройки повреждён: " + error.message, "error");
            return null;
        }
        if (!parsed || typeof parsed !== "object") {
            return null;
        }
        var domain = normalizeHost(parsed.domain);
        if (parsed.enabled !== true || !domain) {
            return { enabled: false, domain: "" };
        }
        return { enabled: true, domain: domain };
    }

    writeConfig(domain) {
        var path = this.configPath();
        if (!path) {
            this.entry("не удалось найти каталог Documents", "error");
            return false;
        }
        var payload = JSON.stringify({ enabled: true, domain: domain });
        if (!file_utils.write_file(path, payload)) {
            this.entry("не удалось записать настройку транспорта", "error");
            return false;
        }
        return true;
    }

    removeConfig(quiet) {
        var path = this.configPath();
        if (path && file_utils.file_exists(path) && !file_utils.delete_file(path)) {
            this.entry("не удалось удалить настройку транспорта", "error");
            if (!quiet) {
                ui.bulletin.show_error("Не удалось выключить транспорт");
            }
            return false;
        }
        if (!quiet) {
            this.entry("настройка транспорта удалена", "info");
        }
        return true;
    }

    // What the client last handed to the engine, or null when it wrote nothing.
    appliedStatus() {
        var path = this.statusPath();
        if (!path) {
            return null;
        }
        var text = file_utils.read_file(path);
        if (!text) {
            return null;
        }
        var parsed = null;
        try {
            parsed = JSON.parse(text);
        } catch (error) {
            return null;
        }
        if (!parsed || typeof parsed !== "object") {
            return null;
        }
        return {
            host: typeof parsed.host === "string" ? parsed.host : "",
            at: typeof parsed.at === "number" ? parsed.at : 0,
        };
    }

    // --- what the screen would write --------------------------------------

    // 0 is "Автоматически"; 1..CF_DOMAINS.length are the zones in order.
    rawDomainIndex() {
        var index = parseInt(this.get_setting("domain_index", 0), 10);
        return isFinite(index) ? index : 0;
    }

    domainIndex() {
        var index = this.rawDomainIndex();
        if (index < 0 || index > CF_DOMAINS.length) {
            return 0;
        }
        return index;
    }

    isAuto() {
        return this.domainIndex() === 0;
    }

    customDomain() {
        return normalizeHost(this.get_setting("custom_domain", ""));
    }

    hasCustomInput() {
        return String(this.get_setting("custom_domain", "")).trim() !== "";
    }

    // The zone the form asks for when it is not automatic; "" when it is.
    desiredDomain() {
        if (this.hasCustomInput()) {
            return this.customDomain();
        }
        var index = this.domainIndex();
        if (index > 0) {
            return CF_DOMAINS[index - 1] || "";
        }
        return "";
    }

    // --- probing ----------------------------------------------------------

    probeOne(domain, timeout, callback) {
        var host = "kws" + PROBE_DATACENTER + "." + domain;
        http.get("https://" + host + "/", { timeout: timeout }, (response) => {
            var status = response && typeof response.status === "number" ? response.status : 0;
            if (status > 0) {
                this.entry("CF " + host + " — ответ " + status, "info");
            } else {
                this.entry("CF " + host + " — нет ответа (" + ((response && response.error) || "таймаут") + ")", "error");
            }
            callback(status);
        });
    }

    // All at once, not one after another: the point of picking a zone is to
    // take the first one that answers, and five sequential four-second timeouts
    // would make a blocked network look like five dead zones in a row.
    probeDomains(domains, timeout, done) {
        var results = [];
        var remaining = domains.length;
        if (remaining === 0) {
            done(results);
            return;
        }
        var finish = () => {
            remaining -= 1;
            if (remaining === 0) {
                done(results);
            }
        };
        for (var i = 0; i < domains.length; i += 1) {
            this.probeInto(domains[i], i, results, timeout, finish);
        }
    }

    probeInto(domain, position, results, timeout, finish) {
        this.probeOne(domain, timeout, (status) => {
            results[position] = { domain: domain, status: status };
            finish();
        });
    }

    // Any answer below 500 means the front is there: DNS and TLS worked and the
    // CloudFlare edge routed the host. 5xx means the edge could not reach the
    // origin, which is exactly what a WebSocket through it would hit too.
    firstReachable(results) {
        for (var i = 0; i < results.length; i += 1) {
            if (results[i] && results[i].status > 0 && results[i].status < 500) {
                return results[i];
            }
        }
        return null;
    }

    // --- connecting -------------------------------------------------------

    // The automatic path, and the only thing the reference app needs a button
    // for: probe every zone, take the first that answers, write it.
    connect() {
        if (this._busy) {
            return;
        }
        var custom = String(this.get_setting("custom_domain", "")).trim();
        if (custom) {
            var domain = normalizeHost(custom);
            if (!domain) {
                this.entry("свой домен не похож на имя хоста", "error");
                ui.bulletin.show_error("Свой домен не похож на имя хоста");
                this.set_setting("enabled", false, true);
                return;
            }
            this.connectFixed(domain);
            return;
        }
        var index = this.domainIndex();
        if (index > 0) {
            this.connectFixed(CF_DOMAINS[index - 1]);
            return;
        }
        this.autoConnect();
    }

    autoConnect() {
        this._busy = true;
        this.entry("автоподбор CF-домена: проверяю " + CF_DOMAINS.length, "info");
        this.probeDomains(CF_DOMAINS, PROBE_TIMEOUT, (results) => {
            this._busy = false;
            var pick = this.firstReachable(results);
            if (!pick) {
                this.entry("ни один CF-домен не ответил", "error");
                ui.bulletin.show_error("Ни один CF-домен не ответил — проверьте сеть");
                this.set_setting("enabled", false, true);
                return;
            }
            this.entry("выбран " + pick.domain + " (ответ " + pick.status + ")", "info");
            this.applyDomain(pick.domain, false);
        });
    }

    // A zone the user asked for by name is applied even when the probe gets
    // nothing: the answer may be a filtered probe rather than a dead front, and
    // refusing a deliberate choice is worse than honouring it with a warning.
    connectFixed(domain) {
        this._busy = true;
        this.probeOne(domain, PROBE_TIMEOUT, (status) => {
            this._busy = false;
            if (status > 0 && status < 500) {
                this.applyDomain(domain, false);
                return;
            }
            this.entry("домен " + domain + " не ответил, всё равно включаю", "error");
            this.applyDomain(domain, true);
        });
    }

    applyDomain(domain, unreachable) {
        if (!this.writeConfig(domain)) {
            ui.bulletin.show_error("Не удалось сохранить настройку");
            this.set_setting("enabled", false, true);
            return;
        }
        this.set_setting("last_domain", domain, false);
        this.entry("маршрут: kws1…5." + domain, "info");
        if (unreachable) {
            ui.bulletin.show_info("Включено: kws1…5." + domain + ". Домен не ответил на проверку.");
        } else {
            ui.bulletin.show_success("Подключено: kws1…5." + domain);
        }
        this.set_setting("transport_reload", Date.now(), true);
    }

    disconnect() {
        var hadConfig = !!this.readConfig();
        this.removeConfig(true);
        this.entry("транспорт выключен", "info");
        if (hadConfig) {
            ui.bulletin.show_info("Выключено. Клиент вернётся на обычный маршрут.");
        }
        this.set_setting("transport_reload", Date.now(), true);
    }

    // --- the switch and the selector --------------------------------------

    onEnabledChanged(value) {
        if (this._loading) {
            return;
        }
        var enabled = value === undefined || value === null ? !!this.get_setting("enabled", true) : !!value;
        if (enabled) {
            this.entry("включение: подбираю домен", "info");
            this.connect();
        } else {
            this.disconnect();
        }
    }

    onDomainChanged(value) {
        if (this._loading) {
            return;
        }
        // Choosing a zone while the transport is off only stores the choice.
        // While it is on, the choice takes effect at once, as the reference app's
        // button would.
        if (!this.get_setting("enabled", true)) {
            return;
        }
        this.connect();
    }

    // --- actions ----------------------------------------------------------

    // Probes only, no write: the reference app's "check" button.
    checkDomains() {
        var domains = CF_DOMAINS;
        if (this.hasCustomInput()) {
            var custom = this.customDomain();
            if (!custom) {
                ui.bulletin.show_error("Свой домен не похож на имя хоста");
                return;
            }
            domains = [custom];
        }
        this.entry("проверка CF-доменов: " + domains.length, "info");
        this.probeDomains(domains, PROBE_TIMEOUT, (results) => {
            var answered = 0;
            for (var i = 0; i < results.length; i += 1) {
                if (results[i] && results[i].status > 0 && results[i].status < 500) {
                    answered += 1;
                }
            }
            this.entry("проверено: " + results.length + ", ответили: " + answered, "info");
            ui.bulletin.show_info("Ответили " + answered + " из " + results.length + " доменов");
        });
    }

    copyDomainList() {
        android_utils.copy_to_clipboard(CF_DOMAINS.join("\n"));
        ui.bulletin.show_copied_to_clipboard();
    }

    copyReport() {
        var config = this.readConfig();
        var applied = this.appliedStatus();
        var errors = [];
        var entries = this.logEntries();
        for (var i = 0; i < entries.length; i += 1) {
            if (entries[i].level === "error") {
                errors.push(entries[i].message);
            }
        }
        var report = "TG WS Proxy (плагин " + __version__ + ")\n";
        report += "Транспорт: " + (config && config.enabled ? "kws1…5." + config.domain : "выключен") + "\n";
        report += "Выбор: " + (this.isAuto() ? "автоматически" : (this.desiredDomain() || "—")) + "\n";
        report += "Клиент применил: " + (applied && applied.host ? applied.host + " в " + formatAppliedTime(applied.at) : "нет подтверждения") + "\n";
        report += "Домены: " + CF_DOMAINS.join(", ") + "\n";
        if (!errors.length) {
            report += "Ошибки: нет\n";
        } else {
            report += "Ошибки:\n- " + errors.slice(-5).join("\n- ") + "\n";
        }
        android_utils.copy_to_clipboard(report);
        ui.bulletin.show_copied_to_clipboard();
    }

    openUrl(url) {
        if (!android_utils.open_url(url)) {
            ui.bulletin.show_error("Не удалось открыть ссылку");
        }
    }

    // --- the status row ---------------------------------------------------

    configSummary() {
        var config = this.readConfig();
        var applied = this.appliedStatus();
        if (!config || !config.enabled) {
            if (this.get_setting("enabled", true)) {
                return "Включается… подбираю CF-домен";
            }
            return "Выключено · клиент на обычном маршруте";
        }
        var text = "Включено: kws1…5." + config.domain;
        if (applied && applied.host && applied.host.indexOf("." + config.domain) >= 0) {
            text += " · клиент применил в " + formatAppliedTime(applied.at);
        } else {
            text += " · клиент ещё переключается";
        }
        var desired = this.desiredDomain();
        if (desired && desired !== config.domain) {
            text += " · выбрано " + desired;
        }
        return text;
    }

    // --- journal (LogManager) ---------------------------------------------

    resetLog() {
        this._log = [];
    }

    logEntries() {
        if (!this._log) {
            this._log = [];
        }
        return this._log;
    }

    isEssential(message) {
        var text = message.toLowerCase();
        for (var i = 0; i < ESSENTIAL_MARKERS.length; i += 1) {
            if (text.indexOf(ESSENTIAL_MARKERS[i].toLowerCase()) >= 0) {
                return true;
            }
        }
        return false;
    }

    entry(message, level) {
        var cleaned = String(message === undefined || message === null ? "" : message)
            .replace(/[↑↓][\s\S]*/, "")
            .trim();
        if (!cleaned) {
            return;
        }
        level = level || "info";
        var entries = this.logEntries();
        var last = entries.length ? entries[entries.length - 1] : null;
        if (last && last.message === cleaned) {
            last.count += 1;
        } else {
            entries.push({ message: cleaned, level: level, count: 1, essential: this.isEssential(cleaned) });
            if (entries.length > MAX_LOG_LINES) {
                entries.shift();
            }
        }
        this.log(cleaned);
    }

    visibleLogs() {
        var entries = this.logEntries();
        var showInfo = !!this.get_setting("log_show_info", true);
        var showError = !!this.get_setting("log_show_error", false);
        var result = [];
        for (var i = 0; i < entries.length; i += 1) {
            var item = entries[i];
            if (item.essential || (showInfo && item.level === "info") || (showError && item.level !== "info")) {
                result.push(item);
            }
        }
        return result;
    }

    logsAsText() {
        var entries = this.visibleLogs();
        var lines = [];
        for (var i = 0; i < entries.length; i += 1) {
            lines.push(entries[i].message + " (x" + entries[i].count + ")");
        }
        return lines.join("\n");
    }

    copyLogs() {
        android_utils.copy_to_clipboard(this.logsAsText());
        ui.bulletin.show_copied_to_clipboard();
    }

    clearLogs() {
        this.resetLog();
        this.entry("журнал очищен", "info");
        this.set_setting("log_reload", Date.now(), true);
    }

    // --- settings screen --------------------------------------------------

    row(key, text, options) {
        options = options || {};
        return new Text({
            key: key,
            text: text,
            icon: options.icon,
            subtext: options.subtext,
            accent: options.accent,
            red: options.red,
            on_click: options.on_click,
            create_sub_fragment: options.create_sub_fragment,
        });
    }

    create_settings() {
        var items = [
            new Header({ text: "Транспорт CloudFlare" }),
            new Switch({
                key: "enabled",
                text: "MTProto через CloudFlare",
                default: true,
                subtext: "Включено — клиент сам выбирает рабочий CF-домен и переключается сразу",
                icon: "msg_folders",
                on_change: (value) => this.onEnabledChanged(value),
            }),
            new Selector({
                key: "domain_index",
                text: "CF-домен",
                default: 0,
                items: ["Автоматически"].concat(CF_DOMAINS),
                icon: "msg_list",
                on_change: (value) => this.onDomainChanged(value),
            }),
            new Input({
                key: "custom_domain",
                text: "Свой домен",
                default: "",
                subtext: "Важнее списка. Применяется кнопкой ниже или повторным включением",
                icon: "msg_link",
            }),
            this.row("status", "Состояние", {
                subtext: this.configSummary(),
                icon: "msg_settings",
            }),
            this.row("connect", this.hasCustomInput() ? "Подключиться к своему домену" : (this.isAuto() ? "Подобрать заново" : "Подключиться к выбранному"), {
                subtext: "Проверит домены и переключит клиент сейчас",
                icon: "msg_retry",
                accent: true,
                on_click: () => {
                    this.set_setting("enabled", true, false);
                    this.connect();
                },
            }),
            new Header({ text: "Проверка" }),
            this.row("check", "Проверить CF-домены", {
                subtext: "Запрос к kws" + PROBE_DATACENTER + ".<домен> с этого устройства",
                icon: "msg_retry",
                on_click: () => this.checkDomains(),
            }),
            this.row("copy_domains", "Скопировать список доменов", {
                icon: "msg_share",
                on_click: () => this.copyDomainList(),
            }),
            new Header({ text: "Журнал" }),
            new Switch({
                key: "log_show_info",
                text: "INFO",
                default: true,
                on_change: () => this.set_setting("log_reload", Date.now(), true),
            }),
            new Switch({
                key: "log_show_error",
                text: "ERROR",
                default: false,
                on_change: () => this.set_setting("log_reload", Date.now(), true),
            }),
            new Switch({
                key: "log_show_null",
                text: "NULL",
                subtext: "Скрыть журнал целиком",
                default: false,
                on_change: () => this.set_setting("log_reload", Date.now(), true),
            }),
            this.row("logs_page", "Открыть журнал", {
                subtext: this.logEntries().length + " строк",
                icon: "msg_list",
                create_sub_fragment: () => this.logsPage(),
            }),
            this.row("logs_copy", "Скопировать журнал", {
                icon: "msg_share",
                on_click: () => this.copyLogs(),
            }),
            this.row("logs_clear", "Очистить журнал", {
                icon: "msg_delete",
                red: true,
                on_click: () => this.clearLogs(),
            }),
            new Header({ text: "О проекте" }),
            this.row("help", "Справка", {
                subtext: "Как это работает и чего не делает",
                icon: "msg_settings",
                create_sub_fragment: () => this.helpPage(),
            }),
            this.row("report", "Собрать отчёт", {
                subtext: "Скопирует настройки и ошибки в буфер",
                icon: "msg_share",
                on_click: () => this.copyReport(),
            }),
            new Divider({}),
        ];
        return items;
    }

    // --- journal page -----------------------------------------------------

    logsPage() {
        var items = [new Header({ text: "Журнал" })];
        if (this.get_setting("log_show_null", false)) {
            items.push(this.row("logs_off", "Отображение логов отключено"));
            return items;
        }
        var entries = this.visibleLogs();
        if (!entries.length) {
            items.push(this.row("logs_empty", "Журнал пуст", {
                subtext: "Включите INFO или ERROR выше",
            }));
            return items;
        }
        for (var i = 0; i < entries.length; i += 1) {
            items.push(new Text({
                key: "log_" + i,
                text: "×" + entries[i].count + "  " + entries[i].message,
            }));
        }
        return items;
    }

    // --- help page --------------------------------------------------------

    helpPage() {
        return [
            new Header({ text: "Что делает плагин" }),
            new Text({ key: "help_1", text: "Включает MTProto через CloudFlare", subtext: "Встроенный веб-транспорт клиента (WebSocket к Telegram Web) ходит на kws1.<домен> … kws5.<домен> — те же зоны, что использует tg-ws-proxy." }),
            new Text({ key: "help_2", text: "Всё внутри клиента", subtext: "Нет локального порта, VPN, отдельного приложения и профиля расширения. Соединение несёт сам клиент, через свой сетевой стек." }),
            new Text({ key: "help_3", text: "Без секрета и без прокси-записи", subtext: "Секрет MTProxy, порт 1443 и пул WebSocket нужны были локальному серверу приложения. Здесь их роль выполняет движок клиента." }),
            new Header({ text: "Как это работает" }),
            new Text({ key: "help_4", text: "Домен выбирается сам", subtext: "При включении плагин одновременно опрашивает все зоны из списка, берёт первую ответившую и записывает её. Ничего нажимать не нужно — это единственное отличие от приложения-референса, где была кнопка." }),
            new Text({ key: "help_5", text: "Подключается сразу", subtext: "Клиент следит за настройкой и переводит живые сессии на выбранный домен без перезапуска. Строка «Состояние» показывает, что клиент применил и во сколько." }),
            new Text({ key: "help_6", text: "Выключение возвращает обычный маршрут", subtext: "Выключите переключатель или сам плагин — настройка снимается, и клиент возвращается на адреса Telegram." }),
            new Text({ key: "help_7", text: "Свой домен", subtext: "Впишите зону, у которой есть поддомены kws1…kws5 на Telegram Web через CloudFlare, и нажмите строку подключения. Свой домен важнее списка." }),
            new Header({ text: "Границы" }),
            new Text({ key: "help_8", text: "Прямой TCP остаётся первым", subtext: "Клиент пробует обычные адреса Telegram и переходит на веб-транспорт, когда они не отвечают. Это тот же сценарий, ради которого существует tg-ws-proxy: сеть режет TCP до Telegram." }),
            new Text({ key: "help_9", text: "Список может устареть", subtext: "Зоны взяты из tg-ws-proxy. Если ни одна не отвечает, плагин честно скажет об этом и не включится." }),
            new Header({ text: "Ссылки" }),
            this.row("help_src", "Оригинальный tg-ws-proxy", {
                subtext: "Flowseal",
                icon: "msg_link",
                on_click: () => this.openUrl("https://github.com/Flowseal/tg-ws-proxy"),
            }),
            this.row("help_fork", "iOS-порт", {
                subtext: "amurcanov",
                icon: "msg_link",
                on_click: () => this.openUrl("https://github.com/amurcanov/tg-ws-proxy-ios"),
            }),
            this.row("help_docs", "MTProto Proxy Reference", {
                subtext: "core.telegram.org",
                icon: "msg_link",
                on_click: () => this.openUrl("https://core.telegram.org/mtproto/mtproto-transports"),
            }),
        ];
    }
}

var Plugin = TgWsProxyPlugin;