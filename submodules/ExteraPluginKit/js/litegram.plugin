// --- settings helpers ------------------------------------------------------

function plugin() {
    return LiteGramPlugin.instance;
}

// The original's `Switch`, which only differs from the SDK one by defaulting
// `link_alias` to the key when none was given.
function MakeSwitch(key, text, options) {
    options = options || {};
    return Switch({
        key: key,
        text: text,
        default: options.default === undefined ? false : options.default,
        subtext: options.subtext === undefined ? null : options.subtext,
        icon: options.icon === undefined ? null : options.icon,
        on_change: options.on_change === undefined ? null : options.on_change,
        on_long_click: options.on_long_click === undefined ? null : options.on_long_click,
        link_alias: options.link_alias === undefined ? key : options.link_alias
    });
}

// "Switch All": the group is switched on only when at least one row is off, so a
// second tap turns everything off instead of leaving it half-on. Every row gets
// the same value; only the last write reloads the screen, which is what the
// original did to avoid rebuilding it six times.
function toggleGroupOptions(keys, defaultValue) {
    var instance = plugin();
    if (!instance) {
        return;
    }
    var target = false;
    for (var i = 0; i < keys.length; i++) {
        if (!instance.get_setting(keys[i], defaultValue === undefined ? false : defaultValue)) {
            target = true;
            break;
        }
    }
    for (var j = 0; j < keys.length; j++) {
        instance.set_setting(keys[j], target, j === keys.length - 1);
    }
}

function toggleSettingsOptions() {
    toggleGroupOptions(SETTINGS_OPTION_ROWS.map(function (row) { return row[0]; }));
}

function togglePremiumEmojiOptions() {
    toggleGroupOptions(PREMIUM_EMOJI_ROWS.map(function (row) { return row[0]; }), true);
}

function togglePremiumStickersOptions() {
    toggleGroupOptions(PREMIUM_STICKERS_ROWS.map(function (row) { return row[0]; }), true);
}

// The premium badge and the collectible status share one visual slot, so the
// original wrote both and then offered a restart.
function premiumBadgeChanged(value) {
    var instance = plugin();
    if (!instance) {
        return;
    }
    instance.set_setting(Keys.hide_premium_badge, value, false);
    instance.set_setting(Keys.hide_collectible_status, value, true);
    showRestartBulletin(value);
}

function showRestartBulletin(enabled) {
    if (enabled) {
        return;
    }
    var bulletin = ui.bulletin.show_with_button(
        t("restart_required"),
        "extera_outline",
        t("restart"),
        function () {
            // `restart_app` killed the process on Android. A plugin cannot exit the
            // app on iOS, and there is no supported API for relaunching it, so the
            // button closes the bulletin: the setting is already saved and applies
            // on the next launch.
            ui.bulletin.show_info(t("restart_required"));
        }
    );
    return bulletin;
}

function openGithub() {
    return android_utils.open_url(GITHUB_URL);
}

// --- settings sections -----------------------------------------------------

function chatSettings() {
    var rows = [
        Header({ text: t("chat_list") }),
        Text({
            key: Keys.hide_stories,
            text: t("hide_stories"),
            link_alias: Keys.hide_stories,
            on_click: null,
            icon: "extera_outline"
        }),
        Text({
            key: Keys.hide_action_bar_status,
            text: t("hide_action_bar_status"),
            link_alias: Keys.hide_action_bar_status,
            on_click: null,
            icon: "extera_outline"
        }),
        MakeSwitch(Keys.hide_greeting_button, t("hide_greeting_button"), { subtext: t("hide_greeting_button_sub") }),
        Header({ text: t("action_bar") }),
        MakeSwitch(Keys.hide_action_bar_live_stream, t("hide_action_bar_live_stream")),
        MakeSwitch(Keys.hide_action_bar_archived_stories, t("hide_action_bar_archived_stories")),
        MakeSwitch(Keys.hide_action_bar_send_gift, t("hide_action_bar_send_gift")),
        MakeSwitch(Keys.hide_action_bar_boost_group, t("hide_action_bar_boost_group")),
        MakeSwitch(Keys.hide_action_bar_add_shortcut, t("hide_action_bar_add_shortcut")),
        MakeSwitch(Keys.hide_action_bar_report, t("hide_action_bar_report")),
        MakeSwitch(Keys.hide_action_bar_clear_history, t("hide_action_bar_clear_history")),
        Header({ text: t("gifts") }),
        MakeSwitch(Keys.hide_bottom_gift_button, t("hide_bottom_gift_button")),
        MakeSwitch(Keys.hide_gift_cards, t("hide_gift_cards")),
        MakeSwitch(Keys.hide_giveaway_cards, t("hide_giveaway_cards")),
        MakeSwitch(Keys.hide_star_reaction, t("hide_star_reaction")),
        MakeSwitch(Keys.hide_group_stickers, t("hide_group_stickers")),
        MakeSwitch(Keys.hide_emoji_search, t("hide_emoji_search")),
        Header({ text: t("premium_emoji_settings_header") }),
        Text({ text: t("switch_all"), key: Keys.switch_all_premium_emoji, link_alias: Keys.switch_all_premium_emoji, on_click: togglePremiumEmojiOptions })
    ];
    // The premium emoji rows were declared with `default=_C` in the original,
    // i.e. on by default: the user sees the filter before choosing it.
    for (var i = 0; i < PREMIUM_EMOJI_ROWS.length; i++) {
        rows.push(MakeSwitch(PREMIUM_EMOJI_ROWS[i][0], t(PREMIUM_EMOJI_ROWS[i][1]), { default: true }));
    }
    rows.push(Header({ text: t("premium_stickers_settings_header") }));
    rows.push(Text({ text: t("switch_all"), key: Keys.switch_all_premium_stickers, link_alias: Keys.switch_all_premium_stickers, on_click: togglePremiumStickersOptions }));
    for (var j = 0; j < PREMIUM_STICKERS_ROWS.length; j++) {
        rows.push(MakeSwitch(PREMIUM_STICKERS_ROWS[j][0], t(PREMIUM_STICKERS_ROWS[j][1]), { default: true }));
    }
    return rows;
}

function profileSettings() {
    var instance = plugin();
    var premiumBadgeHidden = instance ? !!instance.get_setting(Keys.hide_premium_badge, false) : false;
    var rows = [
        Header({ text: t("profile_buttons") }),
        MakeSwitch(Keys.hide_profile_actions_stories_button, t("hide_profile_actions_stories_button")),
        MakeSwitch(Keys.hide_profile_actions_gift_button, t("hide_profile_actions_gift_button")),
        MakeSwitch(Keys.hide_profile_actions_stream_button, t("hide_profile_actions_stream_button")),
        Header({ text: t("profile_tabs") }),
        MakeSwitch(Keys.hide_stories_tab, t("hide_stories_tab")),
        MakeSwitch(Keys.hide_gifts_tab, t("hide_gifts_tab")),
        Header({ text: t("profile_appearance") }),
        Text({
            key: Keys.reply_elements,
            text: t("manage_reply_elements"),
            link_alias: Keys.reply_elements,
            on_click: null,
            icon: "extera_outline"
        }),
        MakeSwitch(Keys.hide_profile_background_emoji, t("hide_profile_background_emoji"), {
            subtext: t("hide_profile_background_emoji_sub")
        }),
        MakeSwitch(Keys.hide_profile_pinned_gifts, t("hide_profile_pinned_gifts")),
        MakeSwitch(Keys.hide_profile_colorful_background, t("hide_profile_colorful_background")),
        MakeSwitch(Keys.hide_boost_badge, t("hide_boost_badge")),
        MakeSwitch(Keys.hide_premium_badge, t("hide_premium_badge"), {
            subtext: t("hide_premium_badge_sub"),
            on_change: premiumBadgeChanged
        })
    ];
    // The collectible status is only offered while the premium badge is on: it is
    // the same visual slot, and the original hid the second switch in that case.
    if (!premiumBadgeHidden) {
        rows.push(MakeSwitch(Keys.hide_collectible_status, t("hide_collectible_status"), {
            subtext: t("hide_collectible_status_sub")
        }));
    }
    rows.push(MakeSwitch(Keys.hide_stars_rating, t("hide_stars_rating")));
    rows.push(MakeSwitch(Keys.hide_bot_verification, t("hide_bot_verification")));
    rows.push(MakeSwitch(Keys.hide_profile_music, t("hide_profile_music")));
    rows.push(MakeSwitch(Keys.hide_profile_business, t("hide_profile_business"), {
        subtext: t("hide_profile_business_sub")
    }));
    return rows;
}

function interfaceSettings() {
    var rows = [
        Header({ text: t("settings_options") }),
        Text({ text: t("switch_all"), key: Keys.switch_all, link_alias: Keys.switch_all, on_click: toggleSettingsOptions })
    ];
    for (var i = 0; i < SETTINGS_OPTION_ROWS.length; i++) {
        rows.push(MakeSwitch(SETTINGS_OPTION_ROWS[i][0], t(SETTINGS_OPTION_ROWS[i][2])));
    }
    rows.push(Header({ text: t("drawer_options") }));
    rows.push(Text({
        key: Keys.drawer_options,
        text: t("manage_drawer_options"),
        link_alias: Keys.drawer_options,
        on_click: null,
        icon: "extera_outline"
    }));
    rows.push(Header({ text: t("premium_features_header") }));
    rows.push(MakeSwitch(Keys.hide_premium_features, t("hide_premium_features"), {
        subtext: t("hide_premium_features_sub")
    }));
    rows.push(MakeSwitch(Keys.hide_articles_editor, t("hide_articles_editor")));
    rows.push(Header({ text: t("ai_features_header") }));
    rows.push(MakeSwitch(Keys.hide_ai_button, t("hide_ai_button")));
    rows.push(MakeSwitch(Keys.hide_ai_summarize, t("hide_ai_summarize")));
    return rows;
}

function aboutSettings() {
    return [
        Header({ text: t("about_plugin") }),
        Text({ text: t("github_repository"), icon: "msg_link", on_click: openGithub }),
        Divider({ text: t("github_sub") })
    ];
}

function mainSettingsList() {
    // Each row carries an explicit `key`: without one the bootstrap derives a
    // key from the visible text, and a translated label would change the
    // identifier `collectSubSettings` looks the page up by. The key is the same
    // string the original used as the section alias.
    return [
        Text({
            key: Keys.chatSettings,
            text: t("category_chat"),
            icon: "msg_discussion",
            create_sub_fragment: chatSettings,
            link_alias: Keys.chatSettings
        }),
        Text({
            key: Keys.profileSettings,
            text: t("category_profile"),
            icon: "msg_contacts",
            create_sub_fragment: profileSettings,
            link_alias: Keys.profileSettings
        }),
        Text({
            key: Keys.interfaceSettings,
            text: t("category_interface"),
            icon: "msg_settings",
            create_sub_fragment: interfaceSettings,
            link_alias: Keys.interfaceSettings
        }),
        Text({
            key: Keys.aboutSettings,
            text: t("category_about"),
            icon: "msg_help",
            create_sub_fragment: aboutSettings,
            link_alias: Keys.aboutSettings
        })
    ];
}

// --- plugin ----------------------------------------------------------------

function LiteGramPlugin() {
    BasePlugin.call(this);
    LiteGramPlugin.instance = this;
    // Answering before `on_plugin_load` is deliberate: the settings are already
    // in the store, and the settings screen may be built before the lifecycle
    // call lands. Only `on_plugin_unload` turns the hook off.
    this.unloaded = false;
    this.warnedAboutAndroidOnly = false;
}

LiteGramPlugin.prototype = Object.create(BasePlugin.prototype);
LiteGramPlugin.prototype.constructor = LiteGramPlugin;

LiteGramPlugin.instance = null;

LiteGramPlugin.prototype.on_plugin_load = function () {
    LiteGramPlugin.instance = this;
    this.unloaded = false;
    // One line instead of a silent no-op: a user who turns on a switch that this
    // build cannot honour should be able to see why in the plugin log rather than
    // guess.
    var enabled = [];
    for (var i = 0; i < ANDROID_ONLY_KEYS.length; i++) {
        if (this.get_setting(ANDROID_ONLY_KEYS[i], false)) {
            enabled.push(ANDROID_ONLY_KEYS[i]);
        }
    }
    if (enabled.length > 0) {
        this.log("LiteGram: " + enabled.length + " switch(es) affect only the Android view tree and have no iOS surface: " + enabled.join(", "));
    }
};

LiteGramPlugin.prototype.on_plugin_unload = function () {
    // A hook must not answer for a plugin that is going away: the host drops the
    // context right after this, and an answer in between would hide settings rows
    // on behalf of a plugin the user just disabled.
    this.unloaded = true;
    if (LiteGramPlugin.instance === this) {
        LiteGramPlugin.instance = null;
    }
};

// The settings tab asks which rows it may build. Keys the host does not know are
// ignored by it, so answering with the full list of what to keep is enough.
LiteGramPlugin.prototype.on_settings_rows_hook = function (account, payload, extra) {
    if (this.unloaded) {
        return undefined;
    }
    var offered = (payload && payload.keys) || [];
    var hidden = {};
    for (var i = 0; i < SETTINGS_OPTION_ROWS.length; i++) {
        var row = SETTINGS_OPTION_ROWS[i];
        if (!this.get_setting(row[0], false)) {
            continue;
        }
        if (Object.prototype.toString.call(row[1]) === "[object Array]") {
            for (var j = 0; j < row[1].length; j++) {
                hidden[row[1][j]] = true;
            }
        } else {
            hidden[row[1]] = true;
        }
    }
    var kept = [];
    for (var k = 0; k < offered.length; k++) {
        if (!hidden[offered[k]]) {
            kept.push(offered[k]);
        }
    }
    return kept;
};

LiteGramPlugin.prototype.create_settings = function () {
    LiteGramPlugin.instance = this;
    return mainSettingsList();
};

LiteGramPlugin.prototype.get_instance = function () {
    return LiteGramPlugin.instance;
};

var Plugin = LiteGramPlugin;