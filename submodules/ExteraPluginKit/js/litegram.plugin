// The lookup the original's `t()` performs: the system language if it has a
// table, English otherwise, and a marker instead of an empty string when a key
// is missing, because a missing translation must be visible rather than blank.
function systemLanguage() {
    var language = "en";
    try {
        var locale = Intl.DateTimeFormat().resolvedOptions().locale || "";
        language = String(locale).split(/[-_]/)[0].toLowerCase();
    } catch (error) {
        language = "en";
    }
    return Object.prototype.hasOwnProperty.call(STRINGS, language) ? language : "en";
}

function t(key) {
    var table = STRINGS[systemLanguage()] || STRINGS.en;
    var value = table[key];
    if (value === undefined) {
        return "MISSING: " + key;
    }
    // The original formats with `str.format(*args)`. No message carries a
    // placeholder, but keeping the arguments accepted means a plugin exported
    // from an older build with a different string still loads.
    var rest = Array.prototype.slice.call(arguments, 1);
    if (rest.length === 0) {
        return value;
    }
    return value.replace(/\{(\d*)\}/g, function (match, index) {
        var position = index === "" ? 0 : parseInt(index, 10);
        return rest[position] === undefined ? match : String(rest[position]);
    });
}

