    [Keys.hide_premium_stickers_grid, "hide_premium_stickers_grid"]
];

// The rows of the settings tab, keyed by the name the host asks about. The
// mapping is explicit because the Android ids the original matched
// (`SettingsRegistry` aliases) do not exist here; the host's identifiers are
// what `PeerInfoSettingsItems` calls the rows it builds.
var SETTINGS_OPTION_ROWS = [
    [Keys.hide_premium_row, "premium", "hide_premium_row"],
    [Keys.hide_stars_row, "stars", "hide_stars_row"],
    [Keys.hide_ton_row, "ton", "hide_ton_row"],
    [Keys.hide_wallet_row, "wallet", "hide_wallet_row"],
    [Keys.hide_business_row, "business", "hide_business_row"],
    [Keys.hide_send_a_gift_row, "sendGift", "hide_send_a_gift_row"],
    // One switch covers the whole Help section, which the host splits into
    // three rows; the original removed the registry entry that contained them.
    [Keys.hide_help_section, ["support", "faq", "tips"], "hide_help_section"]
];

// The switches whose effect exists only in the Android UI. Kept so a settings
// export round-trips and so the screen matches the original, but named once at
// load instead of pretending a tap changed something.
var ANDROID_ONLY_KEYS = [
    Keys.hide_stories,
    Keys.hide_action_bar_status,
    Keys.hide_greeting_button,
